# Copy to server/.env.local, then replace every CHANGE_ME value.
# Never commit server/.env.local. Import the hospital SQL manually before starting HRIS.
HRIS_DB_HOST=127.0.0.1
HRIS_DB_PORT=3306
HRIS_DB_USER=CHANGE_ME_DB_USER
HRIS_DB_PASSWORD=CHANGE_ME_DB_PASSWORD
HRIS_DB_NAME=CHANGE_ME_DB_NAME
HRIS_API_PORT=47102
HRIS_CLIENT_PORT=47101
# Set to the final HTTPS origin when hospital IT provides it, e.g. https://hris.hospital.example
HRIS_ALLOWED_ORIGINS=
HRIS_ADMS_PORT=0
HRIS_RUNTIME_DIR=CHANGE_ME_RUNTIME_DIRECTORY
HRIS_PYTHON_EXE=CHANGE_ME_PYTHON_PATH
HRIS_LIBREOFFICE_EXE=CHANGE_ME_LIBREOFFICE_PATH
HRIS_DEV_AUTO_BOOTSTRAP=0
